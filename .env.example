# Claude Agent SDK 标准 env(SDK 自动识别)
# - 走 Anthropic 官方:ANTHROPIC_BASE_URL 留空、ANTHROPIC_AUTH_TOKEN 填官方 key
# - 走私有网关 / 兼容供应商(GLM / MiniMax 等):BASE_URL 填网关地址、TOKEN 填网关 key
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# 若本机设有 http_proxy / https_proxy,通常要把私有网关 IP 加入 NO_PROXY
# 例:NO_PROXY=110.42.53.85   no_proxy=110.42.53.85
NO_PROXY=
no_proxy=

# Scrivai 框架默认值(可选,供 ModelConfig 与 TrajectoryStore 取默认)
# 例:SCRIVAI_DEFAULT_MODEL=glm-5.1   SCRIVAI_DEFAULT_PROVIDER=glm
SCRIVAI_DEFAULT_MODEL=
SCRIVAI_DEFAULT_PROVIDER=

# M1.0 起 BasePES 直接消费上述 ANTHROPIC_* env;
# 并发场景由 ClaudeAgentOptions(env=...) 注入子进程 env 隔离覆盖。

# OCR 后端配置(scrivai.io.to_markdown)
# SCRIVAI_OCR_BACKEND: 默认 OCR 后端(glm / monkey),默认 glm
SCRIVAI_OCR_BACKEND=glm
# SCRIVAI_GLM_API_KEY: 智谱 GLM-OCR API Key(从 open.bigmodel.cn 获取)
SCRIVAI_GLM_API_KEY=
# SCRIVAI_OCR_BASE_URL: MonkeyOCR 服务地址(仅 monkey 后端使用)
# SCRIVAI_OCR_BASE_URL=http://100.81.95.44:7861
# SCRIVAI_OCR_UPLOAD_RATE: MonkeyOCR 上传限速 bytes/s(仅 monkey 后端,默认 512000)
# SCRIVAI_OCR_UPLOAD_RATE=512000
